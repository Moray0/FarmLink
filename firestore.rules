rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "adeolaoyebimpe3@gmail.com";
    }

    function validRole(role) {
      return role in ["admin", "farmer", "buyer"];
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isFarmer() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userRole() == "farmer";
    }

    function isBuyer() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userRole() == "buyer";
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- Users (private account records) ----------

    match /users/{userId} {

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && (
          request.resource.data.role in ["farmer", "buyer"]
          || (request.resource.data.role == "admin" && isAdmin())
        )
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "role",
          "createdAt",
          "farmName",
          "location"
        ]);

      allow get: if isOwner(userId) || isAdmin();

      allow list: if isAdmin();

      allow update: if signedIn()
        && (
          // Users may edit their own display details, never role or verified.
          (
            isOwner(userId)
            && changedKeys().hasOnly(["displayName", "farmName", "location"])
          )
          // The admin can change roles and approve farmers.
          || (
            isAdmin()
            && changedKeys().hasOnly(["role", "verified", "verifiedAt"])
            && validRole(request.resource.data.role)
          )
        );

      allow delete: if isAdmin();
    }

    // ---------- Farmer profiles (public) ----------

    match /farmerProfiles/{farmerId} {

      allow read: if true;

      allow create: if (
          isOwner(farmerId)
          && isFarmer()
          && request.resource.data.uid == farmerId
          && request.resource.data.role == "farmer"
          && request.resource.data.verified == false
          && request.resource.data.keys().hasOnly([
            "uid",
            "displayName",
            "farmName",
            "location",
            "role",
            "verified",
            "createdAt"
          ])
        )
        || isAdmin();

      allow update: if (
          isOwner(farmerId)
          && changedKeys().hasOnly(["displayName", "farmName", "location"])
        )
        || (
          isAdmin()
          && changedKeys().hasOnly(["verified", "verifiedAt"])
        );

      allow delete: if isAdmin();
    }

    // ---------- Products (public catalogue) ----------

    match /products/{productId} {

      allow read: if true;

      allow create: if isFarmer()
        && request.resource.data.farmerId == request.auth.uid
        && request.resource.data.status == "Available"
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 1
        && request.resource.data.stock <= 100000
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 150000
        && request.resource.data.keys().hasOnly([
          "farmerId",
          "farmerName",
          "farmName",
          "location",
          "name",
          "category",
          "price",
          "quantity",
          "stock",
          "status",
          "image",
          "createdAt"
        ]);

      allow update: if (
          isOwner(resource.data.farmerId)
          && request.resource.data.get("image", "").size() <= 150000
          && changedKeys().hasOnly([
            "name",
            "category",
            "price",
            "quantity",
            "stock",
            "status",
            "image",
            "farmName",
            "farmerName",
            "location"
          ])
        )
        // Checkout and cancellation adjust the stock count (and nothing
        // else) of any product. Stock can never go below zero, and the
        // status must always match whether there is stock left.
        || (
          isBuyer()
          && resource.data.stock is int
          && changedKeys().hasOnly(["stock", "status"])
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && request.resource.data.stock <= 100000
          && (
            (request.resource.data.stock > 0
              && request.resource.data.status == "Available")
            || (request.resource.data.stock == 0
              && request.resource.data.status == "Sold Out")
          )
        )
        || (
          isAdmin()
          && changedKeys().hasOnly(["verified", "verifiedAt"])
        );

      allow delete: if isOwner(resource.data.farmerId) || isAdmin();
    }

    // ---------- Orders ----------

    match /orders/{orderId} {

      allow read: if signedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || request.auth.uid in resource.data.farmerIds
          || isAdmin()
        );

      // Only buyers can place orders, always for themselves and as Pending.
      allow create: if isBuyer()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == "Pending"
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.farmerIds is list
        && request.resource.data.farmerIds.size() > 0
        && request.resource.data.farmerIds.size() <= 50
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.paymentMethod in ["card", "cod"]
        && request.resource.data.paymentStatus in ["Paid (Demo)", "Pay on Delivery"]
        && request.resource.data.keys().hasOnly([
          "buyerId",
          "buyerName",
          "buyerEmail",
          "buyerPhone",
          "deliveryAddress",
          "items",
          "farmerIds",
          "totalAmount",
          "status",
          "createdAt",
          "paymentMethod",
          "paymentStatus",
          "paymentReference",
          "cardBrand",
          "cardLast4"
        ]);

      allow update: if signedIn()
        && (
          // A farmer on the order moves it forward:
          // Pending -> Processing -> Completed. Completing a pay-on-delivery
          // order also marks it as paid.
          (
            request.auth.uid in resource.data.farmerIds
            && changedKeys().hasOnly(["status", "paymentStatus"])
            && (
              (resource.data.status == "Pending"
                && request.resource.data.status == "Processing")
              || (resource.data.status == "Processing"
                && request.resource.data.status == "Completed")
            )
            && (
              !("paymentStatus" in changedKeys())
              || (
                resource.data.paymentMethod == "cod"
                && request.resource.data.status == "Completed"
                && request.resource.data.paymentStatus == "Paid (Demo)"
              )
            )
          )
          // A buyer can cancel their own pending order.
          || (
            resource.data.buyerId == request.auth.uid
            && resource.data.status == "Pending"
            && request.resource.data.status == "Cancelled"
            && changedKeys().hasOnly(["status", "paymentStatus", "cancelledAt"])
            && request.resource.data.paymentStatus in ["Refunded (Demo)", "Cancelled"]
          )
          // A farmer can decline a pending order that only has their products.
          || (
            request.auth.uid in resource.data.farmerIds
            && resource.data.farmerIds.size() == 1
            && resource.data.status == "Pending"
            && request.resource.data.status == "Cancelled"
            && changedKeys().hasOnly(["status", "paymentStatus", "cancelledAt"])
            && request.resource.data.paymentStatus in ["Refunded (Demo)", "Cancelled"]
          )
          || (
            isAdmin()
            && changedKeys().hasOnly(["status"])
          )
        );

      allow delete: if isAdmin();
    }

    // ---------- Notifications ----------

    match /notifications/{notificationId} {

      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      // Anyone signed in can notify someone about an order, but only as
      // themselves and only with the standard fields.
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.read == false
        && request.resource.data.type in [
          "order_placed",
          "order_status",
          "order_cancelled",
          "farmer_inquiry"
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 300
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          "userId",
          "actorId",
          "type",
          "title",
          "message",
          "orderId",
          "read",
          "createdAt"
        ]);

      // The recipient can only mark a notification as read, or delete it.
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && changedKeys().hasOnly(["read"]);

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- Carts (private to the buyer) ----------

    match /carts/{userId} {

      allow read, delete: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && request.resource.data.buyerId == userId
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100
        && request.resource.data.keys().hasOnly([
          "buyerId",
          "items",
          "updatedAt"
        ]);
    }

    // ---------- Saved products (private to the buyer) ----------

    match /savedProducts/{userId}/items/{productId} {
      allow read, write: if isOwner(userId);
    }
  }
}
